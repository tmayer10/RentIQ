# RentIQ Production Environment Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit the actual .env file with secrets to version control

# ============================================================================
# Django Settings
# ============================================================================
DJANGO_SECRET_KEY=<GENERATE_WITH_python_manage.py_shell_-c_"from_django.core.management.utils_import_get_random_secret_key;_print(get_random_secret_key())">
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.yourdomain.com,www.yourdomain.com,yourdomain.com
DJANGO_SETTINGS_MODULE=backend.settings

# ============================================================================
# Database Configuration (RDS PostgreSQL)
# ============================================================================
DB_NAME=rentiq_prod
DB_USER=rentiq_admin
DB_PASSWORD=<RDS_MASTER_PASSWORD>
DB_HOST=<RDS_ENDPOINT>  # e.g., rentiq-db.xxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432

# ============================================================================
# Redis Configuration (ElastiCache)
# ============================================================================
REDIS_URL=redis://<ELASTICACHE_ENDPOINT>:6379/0
REDIS_SESSION_TTL=3600  # 1 hour

# ============================================================================
# API Keys (Store in AWS Secrets Manager)
# ============================================================================
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
GOOGLE_API_KEY=<YOUR_GOOGLE_API_KEY>
PINECONE_API_KEY=<YOUR_PINECONE_API_KEY>

# ============================================================================
# Pinecone Vector Database
# ============================================================================
PINECONE_INDEX_NAME=rental-index
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_NAMESPACE=default

# ============================================================================
# Streamlit Configuration
# ============================================================================
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ENABLE_CORS=false
STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=true

# ============================================================================
# Application URLs
# ============================================================================
BACKEND_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com
STREAMLIT_URL=https://chat.yourdomain.com

# ============================================================================
# AWS Configuration
# ============================================================================
AWS_REGION=us-east-1
AWS_S3_BUCKET=rentiq-frontend-assets
AWS_CLOUDFRONT_DISTRIBUTION_ID=<CLOUDFRONT_DISTRIBUTION_ID>

# ============================================================================
# Email Configuration (Optional - for notifications)
# ============================================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=<AWS_SES_SMTP_USERNAME>
EMAIL_HOST_PASSWORD=<AWS_SES_SMTP_PASSWORD>
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=/var/log/rentiq/app.log

# ============================================================================
# Security & CORS
# ============================================================================
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://chat.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://api.yourdomain.com
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ============================================================================
# Rate Limiting
# ============================================================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ============================================================================
# Monitoring & Performance
# ============================================================================
ENABLE_CLOUDWATCH_LOGS=True
CLOUDWATCH_LOG_GROUP=/aws/ec2/rentiq
ENABLE_SENTRY=False
SENTRY_DSN=<YOUR_SENTRY_DSN>

# ============================================================================
# Gunicorn Configuration
# ============================================================================
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_BIND=127.0.0.1:8000

# ============================================================================
# Feature Flags
# ============================================================================
ENABLE_STRUCTURED_OUTPUT=True
ENABLE_PARALLEL_SEARCH=True
ENABLE_SESSION_STORAGE=True
FILTER_PROVIDER=google  # or 'openai'
